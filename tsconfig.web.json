{
  "extends": "./tsconfig.json",
  "include": [
    "src/renderer/**/*",
    "src/renderer/**/*.vue",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@onething/core": ["packages/core/index.ts"],
      "@onething/core/*": ["packages/core/*/index.ts", "packages/core/*"],
      "@onething/runtime": ["packages/onething-runtime/src/index.ts"],
      "@onething/runtime/*": ["packages/onething-runtime/src/*"],
      "@/*": ["src/renderer/*"],
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
